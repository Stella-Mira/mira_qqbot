# ============================================================
# napcat.conf.example —— start-napcat 全部配置模板（双平台通用）
# 复制为 napcat.conf 并修改后使用：
#   - start-napcat.sh（macOS）：默认同目录 napcat.conf
#   - start-napcat.ps1（Windows）：默认同目录 napcat.conf
#   两者均可通过环境变量 NAPCAT_CONF 指定其他路径
# ============================================================

# 脚本模式
#   restart = 重启模式：QQ 已启动则先关闭再启动
#   start   = 非重启模式：QQ/NapCat 已在运行则跳过，未运行才启动
MODE=restart

# QQ 路径（启动用）
#   macOS   : /Applications/QQ.app
#   Windows : 留空自动从注册表 UninstallString 推断
QQ_PATH=/Applications/QQ.app

# NapCat 路径（启动用）
#   macOS   : $HOME/Library/Containers/<QQ容器标识>/Data/Documents/napcat
#   Windows : 如 D:\QQSpace\NapCat
NAPCAT_PATH=$HOME/Library/Containers/com.tencent.qq/Data/Documents/napcat

# NapCat 媒体目录（发送文件用，voices/images/files 所在；留空 = NAPCAT_PATH/data）
NAPCAT_MEDIA=$NAPCAT_PATH/data

# QQ 号（登录用；留空自动从 config\onebot11_*.json 文件名推断）
# 一次登录成功后快速登录自动上线，免扫码；密码仅票据失效时回退用
# 也可以填 32 位 MD5：QQ_PASSWORD_MD5=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QQ_ACCOUNT=
QQ_PASSWORD=

# qqbot 工作目录（链接视图用；留空 = 脚本所在目录）
# 脚本会在此目录生成链接：
#   macOS   软链   : napcat -> NAPCAT_PATH，napcat-media -> NAPCAT_MEDIA
#   Windows junction: 同上（mklink /J）
QQBOT_DIR=
